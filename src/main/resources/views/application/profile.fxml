<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<?import javafx.scene.control.PasswordField?>
<AnchorPane prefHeight="600.0" prefWidth="600.0" style="-fx-background-color: #E9E9E9;" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controllers.application.ProfileController">
    <children>
        <Text fill="GREY" layoutX="231.0" layoutY="46.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Профиль" underline="true">
            <font>
                <Font name="Times New Roman Italic" size="36.0" />
            </font>
        </Text>

        <Text fill="BLACK" layoutX="78.0" layoutY="107.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Персональная информация:">
         <font>
            <Font name="Times New Roman" size="16.0" />
         </font></Text>
        <Label layoutX="48.0" layoutY="136.0" text="Фамилия:" />
        <TextField fx:id="surnameField" disable="true" layoutX="148.0" layoutY="131.0" prefHeight="26.0" prefWidth="138.0" />

        <Label layoutX="48.0" layoutY="176.0" text="Имя:" />
        <TextField fx:id="nameField" disable="true" layoutX="148.0" layoutY="171.0" prefHeight="26.0" prefWidth="138.0" />

        <Label layoutX="48.0" layoutY="216.0" text="Отчество:" />
        <TextField fx:id="patronymicField" disable="true" layoutX="148.0" layoutY="211.0" prefHeight="26.0" prefWidth="138.0" />

        <Label layoutX="48.0" layoutY="256.0" text="Телефон:" />
        <TextField fx:id="phoneField" disable="true" layoutX="148.0" layoutY="251.0" prefHeight="26.0" prefWidth="138.0" />

        <Label layoutX="48.0" layoutY="296.0" text="Email:" />
        <TextField fx:id="emailField" disable="true" layoutX="148.0" layoutY="291.0" prefHeight="26.0" prefWidth="138.0" />

        <Label layoutX="48.0" layoutY="336.0" text="Адрес:" />
        <TextField fx:id="addressField" disable="true" layoutX="148.0" layoutY="331.0" prefHeight="26.0" prefWidth="140.0" />

        <Label layoutX="48.0" layoutY="376.0" text="Дата рождения:" />
        <TextField fx:id="birthdayField" disable="true" layoutX="148.0" layoutY="371.0" prefHeight="26.0" prefWidth="140.0" />

        <Button fx:id="editPersonalButton" layoutX="52.0" layoutY="416.0" mnemonicParsing="false" onAction="#EnableEditingPersonal_Pressed" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #808080;" text="Редактировать" textFill="WHITE">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>

        <Button fx:id="savePersonalButton" disable="true" layoutX="173.0" layoutY="416.0" mnemonicParsing="false" onAction="#SavePersonal_Pressed" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #808080;" text="Сохранить" textFill="WHITE">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>

        <Text fill="BLACK" layoutX="375.0" layoutY="106.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Логин и пароль:">
         <font>
            <Font name="Times New Roman" size="16.0" />
         </font></Text>
        <Label layoutX="316.0" layoutY="137.0" text="Логин:" />
        <TextField fx:id="loginField" disable="true" layoutX="431.0" layoutY="133.0" prefHeight="26.0" prefWidth="138.0" />

        <Label layoutX="316.0" layoutY="177.0" text="Пароль:" />
        <PasswordField fx:id="passwordField" disable="true" layoutX="431.0" layoutY="173.0" prefHeight="26.0" prefWidth="138.0" />

        <Label layoutX="316.0" layoutY="217.0" text="Повторите пароль:" />
        <PasswordField fx:id="repeatPasswordField" disable="true" layoutX="431.0" layoutY="213.0" prefHeight="26.0" prefWidth="138.0" />

        <Label fx:id="messageLabel" layoutY="477.0" prefHeight="18.0" prefWidth="600.0" style="-fx-alignment: center;" textAlignment="CENTER" textFill="red" />

        <Button fx:id="editCredentialsButton" layoutX="325.0" layoutY="258.0" mnemonicParsing="false" onAction="#EnableEditingCredentials_Pressed" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #808080;" text="Редактировать" textFill="WHITE">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>

        <Button fx:id="saveCredentialsButton" disable="true" layoutX="450.0" layoutY="258.0" mnemonicParsing="false" onAction="#SaveCredentials_Pressed" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #808080;" text="Сохранить" textFill="WHITE">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>

        <Button fx:id="backButton" layoutX="250.0" layoutY="520.0" mnemonicParsing="false" onAction="#Back_Pressed" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #D55C5C;" text="Назад" textFill="WHITE">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>

    </children>
</AnchorPane>
