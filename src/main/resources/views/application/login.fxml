<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<?import javafx.scene.Cursor?>
<AnchorPane prefHeight="315.0" prefWidth="265.0" style="-fx-background-color: #E9E9E9;" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controllers.application.LoginController">
   <children>
      <Text fill="GREY" layoutX="88.0" layoutY="58.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Вход">
         <font>
            <Font name="Times New Roman Italic" size="42.0" />
         </font>
      </Text>
      <Label layoutX="58.0" layoutY="92.0" text="Логин:">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label layoutX="58.0" layoutY="154.0" text="Пароль:">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <TextField fx:id="loginField" layoutX="57.0" layoutY="113.0" prefWidth="150.0" />
      <PasswordField fx:id="passwordField" layoutX="57.0" layoutY="175.0" prefWidth="150.0" />

      <Label fx:id="messageLabel" layoutY="215.0" prefWidth="265.0" styleClass="message-label" style="-fx-alignment: center;" textAlignment="CENTER" textFill="red" />

      <Button fx:id="loginButton" layoutX="98.0" layoutY="242.0" mnemonicParsing="false" onAction="#Login_Pressed" prefHeight="26.0" prefWidth="65.0" style="-fx-background-color: #808080;" styleClass="login-button" text="Войти" textFill="WHITE">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>

      <Hyperlink fx:id="registerButton" layoutX="54.0" layoutY="277.0" onAction="#Register_Pressed" text="Нет аккаунта? Регистрация" />
   </children>
</AnchorPane>
