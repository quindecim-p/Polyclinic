<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="610.0" prefWidth="800.0" style="-fx-background-color: #E9E9E9;" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controllers.doctor.HistoryController">
    <children>
        <Text fill="GREY" layoutX="263.0" layoutY="46.0" strokeType="OUTSIDE" strokeWidth="0.0" text="История приемов" underline="true">
            <font>
                <Font name="Times New Roman Italic" size="36.0" />
            </font>
        </Text>

        <Label layoutX="20.0" layoutY="80.0" text="Список приемов:" />
        <ListView fx:id="appointmentsList" layoutX="20.0" layoutY="110.0" prefHeight="420.0" prefWidth="200.0" style="-fx-border-color: #BEBEBE;" />

        <Label layoutX="264.0" layoutY="80.0" text="Фильтры:" />
        <Label layoutX="263.0" layoutY="108.0" text="От:" />
        <DatePicker fx:id="dateFromPicker" layoutX="290.0" layoutY="104.0" prefHeight="26.0" prefWidth="139.0">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </DatePicker>
        <Label layoutX="453.0" layoutY="108.0" text="До:" />
        <DatePicker fx:id="dateToPicker" layoutX="482.0" layoutY="104.0" prefHeight="26.0" prefWidth="139.0">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </DatePicker>
        <Button layoutX="641.0" layoutY="104.0" onAction="#filterAppointments" text="Применить">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>

        <TabPane layoutX="242.0" layoutY="179.0" prefHeight="390.0" prefWidth="522.0" style="-fx-tab-min-width: 150px; -fx-tab-max-width: 150px;">
            <tabs>
                <Tab text="Основное">
                    <AnchorPane>
                        <children>
                            <Label layoutX="20.0" layoutY="20.0" text="Пациент:" />
                            <TextArea fx:id="patientDetailsText" editable="false" layoutX="20.0" layoutY="40.0" prefHeight="50.0" prefWidth="480.0" wrapText="true" />

                            <Label layoutX="20.0" layoutY="110.0" text="Симптомы:" />
                            <TextArea fx:id="symptomsText" editable="false" layoutX="20.0" layoutY="130.0" prefHeight="70.0" prefWidth="480.0" wrapText="true" />

                            <Label layoutX="20.0" layoutY="210.0" text="Диагноз:" />
                            <TextArea fx:id="diagnosisText" editable="false" layoutX="20.0" layoutY="230.0" prefHeight="70.0" prefWidth="480.0" wrapText="true" />
                        </children>
                    </AnchorPane>
                </Tab>
                <Tab text="Рецепт">
                    <AnchorPane>
                        <children>
                            <Label layoutX="20.0" layoutY="20.0" text="Инструкции по приему лекарств:" />
                            <TextArea fx:id="prescriptionText" editable="false" layoutX="20.0" layoutY="40.0" prefHeight="280.0" prefWidth="480.0" wrapText="true" />
                        </children>
                    </AnchorPane>
                </Tab>
                <Tab text="Справка">
                    <AnchorPane>
                        <children>
                            <Label layoutX="20.0" layoutY="20.0" text="Рекомендации и срок действия:" />
                            <TextArea fx:id="referenceText" editable="false" layoutX="20.0" layoutY="40.0" prefHeight="280.0" prefWidth="480.0" wrapText="true" />
                        </children>
                    </AnchorPane>
                </Tab>
            </tabs>
        </TabPane>

        <Button fx:id="backButton" layoutX="65.0" layoutY="550.0" mnemonicParsing="false" onAction="#Back_Pressed" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #D55C5C;" text="Назад" textFill="WHITE">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>

        <Label layoutX="265.0" layoutY="148.0" text="Поиск:" />
        <TextField fx:id="searchField" layoutX="311.0" layoutY="144.0" prefHeight="26.0" prefWidth="310.0" promptText="Введите фамилию или номер карты..." />

    </children>
</AnchorPane>