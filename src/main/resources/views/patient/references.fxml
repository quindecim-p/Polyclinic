<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #E9E9E9;" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controllers.patient.ReferencesController">
    <children>
        <Label layoutX="279.0" layoutY="10.0" text="Список справок" textFill="GREY">
         <font>
            <Font name="Times New Roman Italic" size="36.0" />
         </font></Label>

        <TableView fx:id="referencesTable" layoutX="30.0" layoutY="60.0" prefHeight="400.0" prefWidth="740.0">
            <columns>
                <TableColumn fx:id="detailsColumn" prefWidth="400.0" text="Детали" />
                <TableColumn fx:id="validFromColumn" prefWidth="150.0" text="Действительна с" />
                <TableColumn fx:id="validUntilColumn" prefWidth="150.0" text="Действительна до" />
            </columns>
        </TableView>

        <Label layoutX="30.0" layoutY="473.0" style="-fx-font-size: 16px;" text="Фильтры" />
        <Label layoutX="30.0" layoutY="510.0" text="Дата с:" />
        <DatePicker fx:id="startDatePicker" layoutX="79.0" layoutY="505.0" prefHeight="26.0" prefWidth="156.0">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </DatePicker>
        <Label layoutX="292.0" layoutY="510.0" text="Дата до:" />
        <DatePicker fx:id="endDatePicker" layoutX="352.0" layoutY="505.0" prefHeight="26.0" prefWidth="156.0">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </DatePicker>
        <Label layoutX="570.0" layoutY="509.0" text="Поиск:" />
        <TextField fx:id="searchField" layoutX="614.0" layoutY="505.0" prefHeight="26.0" prefWidth="156.0" />

        <Button layoutX="335.0" layoutY="550.0" mnemonicParsing="false" onAction="#applyFilters" text="Применить фильтры">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>
        <Button layoutX="30.0" layoutY="550.0" mnemonicParsing="false" onAction="#goBack" prefHeight="26.0" prefWidth="103.0" style="-fx-background-color: #D55C5C;" text="Назад" textFill="WHITE">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>
    </children>
</AnchorPane>
