<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="509.0" prefWidth="499.0" style="-fx-background-color: #E9E9E9;" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controllers.patient.AppointmentController">
    <children>
        <Text fill="GREY" layoutX="124.0" layoutY="46.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Запись на прием" underline="true">
            <font>
                <Font name="Times New Roman Italic" size="36.0" />
            </font>
        </Text>

        <Label layoutX="80.0" layoutY="84.0" text="Выберите врача:" />
        <ComboBox fx:id="doctorSelector" layoutX="247.0" layoutY="79.0" prefHeight="26.0" prefWidth="174.0">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </ComboBox>

        <Label layoutX="80.0" layoutY="134.0" text="Выберите дату:" />
        <DatePicker fx:id="datePicker" layoutX="247.0" layoutY="129.0" prefHeight="26.0" prefWidth="174.0">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </DatePicker>

        <Label layoutX="80.0" layoutY="184.0" text="Выберите время:" />
        <ComboBox fx:id="timeSelector" layoutX="247.0" layoutY="179.0" prefHeight="26.0" prefWidth="174.0">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </ComboBox>

        <Label layoutX="78.0" layoutY="237.0" text="Выбранный врач:" />
        <Text fx:id="selectedDoctorDetails" layoutX="247.0" layoutY="250.0" wrappingWidth="174.39999999999986" />

        <Label layoutX="80.0" layoutY="305.0" text="Симптомы:" />
        <TextArea fx:id="symptomsField" layoutX="180.0" layoutY="305.0" prefHeight="98.0" prefWidth="251.0" />

        <Button fx:id="confirmButton" layoutX="107.0" layoutY="438.0" mnemonicParsing="false" onAction="#Confirm_Appointment" prefHeight="30.0" prefWidth="120.0" style="-fx-background-color: #5CAD5C;" text="Записаться" textFill="WHITE">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>

        <Button fx:id="backButton" layoutX="273.0" layoutY="438.0" mnemonicParsing="false" onAction="#Back_Pressed" prefHeight="30.0" prefWidth="120.0" style="-fx-background-color: #D55C5C;" text="Назад" textFill="WHITE">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>
    </children>
</AnchorPane>
