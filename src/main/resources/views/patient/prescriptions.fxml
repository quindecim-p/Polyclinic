<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #E9E9E9;" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controllers.patient.PrescriptionController">
    <VBox alignment="TOP_CENTER" spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Список рецептов" />

        <HBox alignment="CENTER" spacing="10.0">
            <TextField fx:id="searchField" promptText="Поиск по инструкции" />
            <Button onAction="#applyFilters" text="Применить фильтр">
                <cursor>
                    <Cursor fx:constant="HAND" />
                </cursor>
            </Button>
        </HBox>

        <TableView fx:id="prescriptionsTable" prefHeight="300.0">
            <columns>
                <TableColumn fx:id="instructionsColumn" prefWidth="500.0" text="Инструкция" />
            </columns>
        </TableView>

        <Button onAction="#goBack" prefHeight="26.0" prefWidth="92.0" style="-fx-background-color: #D55C5C;" text="Назад" textFill="WHITE">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>
    </VBox>
</AnchorPane>