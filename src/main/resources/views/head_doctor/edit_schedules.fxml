<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="659.0" prefWidth="634.0" style="-fx-background-color: #E9E9E9;" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controllers.head_doctor.EditSchedulesController">
    <children>
        <Text fill="GREY" layoutX="96.0" layoutY="47.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Редактирование расписаний" underline="true">
            <font>
                <Font name="Times New Roman Italic" size="36.0" />
            </font>
        </Text>

        <Label layoutX="157.0" layoutY="94.0" text="Выберите врача:" />
        <ComboBox fx:id="doctorSelection" layoutX="277.0" layoutY="89.0" prefWidth="200.0">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </ComboBox>

        <Label layoutX="157.0" layoutY="134.0" text="Выберите день:" />
        <ComboBox fx:id="daySelection" layoutX="277.0" layoutY="129.0" prefWidth="200.0">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </ComboBox>

        <Label layoutX="157.0" layoutY="174.0" text="Рабочее время:" />
        <Spinner fx:id="startTimePicker" layoutX="277.0" layoutY="169.0" prefWidth="70.0">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Spinner>
        <Label layoutX="357.0" layoutY="174.0" text="до" />
        <Spinner fx:id="endTimePicker" layoutX="387.0" layoutY="169.0" prefWidth="70.0">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Spinner>

        <Button fx:id="saveButton" layoutX="193.0" layoutY="219.0" mnemonicParsing="false" onAction="#saveSchedule" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #5CB85C;" text="Сохранить" textFill="WHITE">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>

        <Button fx:id="deleteButton" layoutX="347.0" layoutY="219.0" mnemonicParsing="false" onAction="#deleteSchedule" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #D55C5C;" text="Удалить" textFill="WHITE">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>

        <TextArea fx:id="schedulePreview" editable="false" layoutX="192.0" layoutY="273.0" prefHeight="298.0" prefWidth="254.0" wrapText="true" />

        <Button fx:id="backButton" layoutX="267.0" layoutY="602.0" mnemonicParsing="false" onAction="#Back_Pressed" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #D55C5C;" text="Назад" textFill="WHITE">
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Button>
    </children>
</AnchorPane>