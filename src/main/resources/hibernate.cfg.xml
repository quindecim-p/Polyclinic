<!DOCTYPE hibernate-configuration PUBLIC "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- Database connection settings -->
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/Polyclinic</property>
        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password">root</property>

        <!-- JDBC connection pool settings -->
        <property name="hibernate.c3p0.min_size">5</property>
        <property name="hibernate.c3p0.max_size">20</property>
        <property name="hibernate.c3p0.timeout">300</property>
        <property name="hibernate.c3p0.max_statements">50</property>
        <property name="hibernate.c3p0.idle_test_period">3000</property>

        <!-- SQL dialect -->
        <property name="hibernate.dialect">org.hibernate.dialect.MySQLDialect</property>

        <!-- Show SQL -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>

        <!-- Drop and re-create the database schema on startup -->
        <property name="hibernate.hbm2ddl.auto">update</property>


        <!-- Mapping files -->
        <mapping class="common.entities.Appointment"/>
        <mapping class="common.entities.Prescription"/>
        <mapping class="common.entities.Reference"/>
        <mapping class="common.entities.Diagnosis"/>
        <mapping class="common.entities.Doctor"/>
        <mapping class="common.entities.MedicalCard"/>
        <mapping class="common.entities.Patient"/>
        <mapping class="common.entities.PersonData"/>
        <mapping class="common.entities.Role"/>
        <mapping class="common.entities.User"/>
        <mapping class="common.entities.WorkDay"/>
        <mapping class="common.entities.WorkingSchedule"/>

    </session-factory>
</hibernate-configuration>